TELOXIDE_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>

# Claude Code subprocess
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=claude-sonnet-4-6
CLAUDE_CODE_TIMEOUT_SECS=180
CLAUDE_CODE_SESSION_FILE=data/claude_session_id
# Legacy env vars also supported: CODEX_CLI_BIN, CODEX_MODEL, CODEX_TIMEOUT_SECS

# claude CLI auth on a headless server. Pick ONE:
#  (a) API billing — set the key here; the claude subprocess inherits it.
#  (b) Subscription — leave blank and run `claude setup-token` as the service
#      user so ~/.claude/.credentials.json exists (HOME is set in the unit).
ANTHROPIC_API_KEY=

DATABASE_URL=sqlite://data/jarvis.db

# Required: the bot answers only OWNER_USER_ID (your numeric Telegram user id).
ALLOWED_USERS=
OWNER_USER_ID=
BOT_ALIASES=jarvis,bot

RAG_TOP_K=6
RAG_CANDIDATE_LIMIT=2000
MAX_CONTEXT_CHARS=4000
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt
USER_RULES_FILE=prompts/user_rules.txt

# Tools allowed for Claude Code. Built-in WebSearch/WebFetch give Jarvis real
# internet access (Anthropic server-side — no scraping, no extra API key; on
# API-key billing WebSearch costs $10/1000 searches, on subscription tokens
# it counts toward usage limits).
CLAUDE_CODE_ALLOWED_TOOLS=mcp__telegram__*,WebSearch,WebFetch
# Optional extras (append if wanted):
#   Read,Glob,Grep            — read-only filesystem access on the server
#   Task                      — subagents for parallel work
#   Bash(journalctl -u jarvis-bot:*),Bash(systemctl status:*)
#                             — SCOPED shell only; a bare `Bash` would let any
#                               prompt-injected content run commands on the VPS.
# Legacy: CODEX_ALLOWED_TOOLS

# Proactive group monitoring (format: chat_id or chat_id:thread_id, comma-separated)
# Example: -1001234567890:42 monitors only forum topic 42 of that supergroup
MONITORED_GROUPS=
PROACTIVE_COOLDOWN_SECS=300
PROACTIVE_BOT_COOLDOWN_SECS=60
PROACTIVE_DECISION_TIMEOUT_SECS=30

# LLM cold trigger: when true, Jarvis evaluates every group message that has
# no @mention/reply/alias trigger and may decide to respond (e.g. "javob qaytar").
# Rate-limited by PROACTIVE_COOLDOWN_SECS globally and a 10s per-chat debouncer.
PROACTIVE_COLD_TRIGGER_ENABLED=true

# FACEIT CS2 API (optional — enables faceit_profile, faceit_matches, faceit_match MCP tools)
# Get your API key at https://developers.faceit.com/
FACEIT_API_KEY=

# Google Sheets API (optional — enables sheets_read, sheets_write, sheets_append, etc.)
# Path to Google Cloud service account JSON key file
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable "Google Sheets API" in your GCP project
# Share target spreadsheets with the service account email
GOOGLE_SERVICE_ACCOUNT_KEY=

# Web search backends for the mcp web_search tool (tried in this order; without
# a key it falls back to DuckDuckGo scraping, which datacenter IPs get blocked
# from). Brave: free 2000 q/mo at https://api-dashboard.search.brave.com
# Tavily: free 1000 credits/mo at https://tavily.com
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Voice transcription for the transcribe_voice tool (Whisper). Groq has a free
# tier at https://console.groq.com — preferred. OpenAI used as fallback.
GROQ_API_KEY=
OPENAI_API_KEY=

# Google Calendar (optional — enables calendar_list_events, calendar_create_event,
# calendar_delete_event). Reuses GOOGLE_SERVICE_ACCOUNT_KEY above; share the
# calendar with the service account email (editor role) and put its id here.
GOOGLE_CALENDAR_ID=

# Gmail (optional — enables gmail_search, gmail_list_recent, gmail_read_message,
# and the send_email_application SMTP sender). Uses an app password, NOT your
# normal login: https://myaccount.google.com/apppasswords
GMAIL_IMAP_USER=
GMAIL_APP_PASSWORD=
# SMTP defaults to the Gmail account above. Override for a non-Gmail relay:
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Webhook mode: set WEBHOOK_URL to your public HTTPS endpoint (Telegram only
# accepts ports 443/80/88/8443 — terminate TLS at Caddy/cloudflared on 443).
# WEBHOOK_BIND is the internal upstream the reverse proxy targets (arbitrary
# port). Leave WEBHOOK_URL empty for long polling (no public URL needed).
WEBHOOK_URL=
WEBHOOK_BIND=0.0.0.0:8081

# Blog publishing (optional — enables the publish_blog tool). POSTs
# {"title","content"} JSON with an X-Post-Token header to BLOG_INTERNAL_URL,
# expects {"id": <int>} back; BLOG_PUBLIC_URL is the base for the returned link.
# BLOG_INTERNAL_URL=http://127.0.0.1:8001/api/posts/internal/create/
# BLOG_POST_TOKEN=
# BLOG_PUBLIC_URL=https://blog.example.com/blog

# ── Dashboard ──
# Shared secret the dashboard routes require in the X-Dash-Auth header (injected
# by the nginx status vhost). Unset => dashboard routes return 404 (disabled).
DASHBOARD_AUTH_SECRET=
# Denominator for the live context-fill gauge. 200000 for standard opus-4-8;
# 1000000 if you switch to a 1M-context model.
CONTEXT_WINDOW_TOKENS=200000
